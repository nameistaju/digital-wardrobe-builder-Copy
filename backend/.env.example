# ==============================================================================
# DIGITAL WARDROBE BUILDER - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: Copy this file to '.env' for local development.
# Safe defaults are provided below for zero-setup local development.

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS & Client Origins
# ------------------------------------------------------------------------------
# Primary origin of your frontend client
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated list of additional allowed origins for production (e.g. Vercel)
# CORS_ORIGINS=https://digital-wardrobe.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# 3. Database Connection
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./wardrobe.db

# Production (Supabase PostgreSQL):
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# ------------------------------------------------------------------------------
# 4. Security & JWT
# ------------------------------------------------------------------------------
# In production, set a secure randomly generated string (minimum 32 characters)
SECRET_KEY=dev-wardrobe-secret-key-min-32-chars-long-2026-secure
# JWT_SECRET_KEY=alternative-alias-for-cloud-environments

# ------------------------------------------------------------------------------
# 5. Asset Storage Configuration
# ------------------------------------------------------------------------------
# Choose: 'local' (development filesystem) or 'r2' (Cloudflare R2 Object Storage)
STORAGE_PROVIDER=local

# Local Storage Directory (used when STORAGE_PROVIDER=local)
STORAGE_DIR=storage

# Cloudflare R2 Credentials (used when STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=digital-wardrobe-assets
# R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 6. Dedicated Neural Virtual Try-On (IDM-VTON)
# ------------------------------------------------------------------------------
# Hugging Face User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN=
IDM_VTON_SPACE=yisol/IDM-VTON
TRYON_TIMEOUT_SECONDS=120


